# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (strict: exclude all secrets, keep safe template)
.env*
!.env.example
.gate-credentials-handoff.json
.test-credentials.json

# vercel & puppeteer
.vercel
.puppeteer-cache/

# test artifacts & generated evidence
test-results/
playwright-results.json
evidence-downloads/
evidence-screenshots/
test-portrait-downloads/
.downloads-test/
*.png
!public/**
!tests/fixtures/**
!test/fixtures/**
!src-tauri/icons/**

# tauri & rust
src-tauri/target/
src-tauri/gen/


# typescript
*.tsbuildinfo
next-env.d.ts

# generated benchmark JSONs
benchmark-*.json
__pycache__/
scratch/
data/
