# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (strict: exclude all secrets, keep safe template)
.env*
!.env.example

# vercel & puppeteer
.vercel
.puppeteer-cache/

# test artifacts & generated evidence
test-results/
evidence-downloads/
evidence-screenshots/
test-portrait-downloads/
.downloads-test/
*.png
!public/**
!tests/fixtures/**

# typescript
*.tsbuildinfo
next-env.d.ts
