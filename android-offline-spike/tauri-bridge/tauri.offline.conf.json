{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PLP Math Offline",
  "version": "1.0.0",
  "identifier": "com.dytcore.plpmath",
  "build": {
    "devUrl": null,
    "frontendDist": "out_android"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' tauri: 'unsafe-inline' 'unsafe-eval' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 24,
      "targetSdkVersion": 36,
      "abiFilters": ["arm64-v8a"]
    }
  }
}
