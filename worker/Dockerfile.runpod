# RunPod Serverless GPU Dockerfile for PLP Math Content & Background Removal Worker
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=4 \
    U2NET_HOME=/root/.u2net

WORKDIR /

# Install runtime dependencies for OpenCV and image processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install RunPod Serverless SDK, ONNX, rembg, and Alpha Matting stack
RUN pip install --no-cache-dir \
    runpod==1.7.7 \
    rembg==2.0.60 \
    onnxruntime \
    numpy<2.0.0 \
    Pillow \
    opencv-contrib-python-headless \
    scipy \
    numba \
    pymatting

# Pre-download default model weights during Docker build to ensure zero cold-start model download delay
RUN python -c "from rembg import new_session; new_session('u2net')"

COPY alpha_matting.py runpod_app.py /

ENV REMBG_MODEL=u2net \
    MAX_UPLOAD_BYTES=15728640 \
    MAX_MATTING_PIXELS=4194304

CMD ["python", "-u", "/runpod_app.py"]
